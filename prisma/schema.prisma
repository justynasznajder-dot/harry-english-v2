  schools                               schools?                       @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([school_id, email])
  @@unique([school_id, client_number], map: "users_school_client_number_key")
  @@index([email], map: "idx_users_email")
  @@index([reset_token], map: "idx_users_reset_token")
  @@index([role], map: "idx_users_role")
  @@index([school_id], map: "idx_users_school_id")
}

