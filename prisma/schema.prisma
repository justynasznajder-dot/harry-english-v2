// HarryEnglish — schemat bazy (źródło prawdy). Połączenie CLI: prisma.config.ts
// Migracje: prisma/migrations/ — patrz prisma/MIGRATE.md
// Runtime aplikacji: pg + raw SQL (lib/db.ts), bez Prisma Client

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model announcements {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  school_id    String
  author_id    String
  title        String    @db.VarChar(255)
  body         String
  target_role  String?   @db.VarChar(50)
  published_at DateTime  @default(now()) @db.Timestamp(6)
  expires_at   DateTime? @db.Timestamp(6)
  users        users     @relation(fields: [author_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schools      schools   @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([school_id], map: "idx_announcements_school_id")
}

model attendance {
  id        String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  lesson_id String
  child_id  String
  status    AttendanceStatus @default(PRESENT)
  note      String?
  children  children         @relation(fields: [child_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lessons   lessons          @relation(fields: [lesson_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([lesson_id, child_id])
  @@index([child_id], map: "idx_attendance_child_id")
  @@index([lesson_id], map: "idx_attendance_lesson_id")
}

model child_auth {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  child_id      String    @unique
  username      String    @unique @db.VarChar(100)
  password_hash String    @db.VarChar(255)
  last_login    DateTime? @db.Timestamp(6)
  children      children  @relation(fields: [child_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model child_rewards {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  child_id  String
  reward_id String
  earned_at DateTime @default(now()) @db.Timestamp(6)
  children  children @relation(fields: [child_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rewards   rewards  @relation(fields: [reward_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([child_id], map: "idx_child_rewards_child_id")
}

model children {
  id                    String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  school_id             String
  parent_id             String
  /// Stały numer dziecka: {parent.client_number}/{seq}, np. 00001/1
  client_number         String?              @db.VarChar(16)
  first_name            String               @db.VarChar(100)
  last_name             String               @db.VarChar(100)
  birth_date            DateTime             @db.Date
  avatar_url            String?
  xp_total              Int                  @default(0)
  active                Boolean              @default(true)
  resignation_requested Boolean              @default(false)
  resignation_reason    String?
  resignation_date      DateTime?            @db.Timestamp(6)
  created_at            DateTime             @default(now()) @db.Timestamp(6)
  confirmed             Boolean              @default(false)
  enrollment_request_id String?
  access_level          String               @default("NEW")
  /// Indywidualne nadpisanie stawek (null = cennik grupy / zapis)
  lesson_unit_price     Decimal?             @db.Decimal(10, 2)
  monthly_unit_price    Decimal?             @db.Decimal(10, 2)
  yearly_unit_price     Decimal?             @db.Decimal(10, 2)
  attendance            attendance[]
  child_auth            child_auth?
  child_rewards         child_rewards[]
  enrollment_requests   enrollment_requests? @relation(fields: [enrollment_request_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                 users                @relation(fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schools               schools              @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contract_children     contract_children[]
  contracts             contracts[]
  group_students        group_students[]
  lesson_billing_periods lesson_billing_periods[]
  invoices              invoices[]
  invoice_items         invoice_items[]
  payments              payments[]
  progress_notes        progress_notes[]
  renewals              renewals[]
  subscriptions         subscriptions[]

  @@unique([school_id, client_number], map: "children_school_client_number_key")
  @@index([parent_id], map: "idx_children_parent_id")
  @@index([school_id], map: "idx_children_school_id")
}

model contract_children {
  school_id             String
  contract_id           String
  child_id              String
  enrollment_request_id String?
  group_id              String?
  sort_order            Int                  @default(0)
  attachment_1_html     String?
  attachment_2_html     String?
  lesson_unit_price     Decimal?             @db.Decimal(10, 2)
  monthly_unit_price    Decimal?             @db.Decimal(10, 2)
  yearly_unit_price     Decimal?             @db.Decimal(10, 2)
  schools               schools              @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children              children             @relation(fields: [child_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contracts             contracts            @relation(fields: [contract_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  enrollment_requests   enrollment_requests? @relation(fields: [enrollment_request_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groups                groups?              @relation(fields: [group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([contract_id, child_id])
  @@index([child_id], map: "idx_contract_children_child")
  @@index([school_id], map: "idx_contract_children_school_id")
}

model contract_templates {
  id            String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  school_id     String
  name          String      @db.VarChar(255)
  content_html  String
  active        Boolean     @default(true)
  created_at    DateTime    @default(now()) @db.Timestamp(6)
  school_year   String?     @db.VarChar(9)
  updated_at    DateTime    @default(now()) @db.Timestamptz(6)
  template_kind String      @default("CONTRACT")
  schools       schools     @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contracts     contracts[]

  @@index([school_id, template_kind, school_year], map: "contract_templates_school_kind_year_idx", where: raw("(active = true)"))
  @@index([school_id], map: "idx_contract_templates_school_id")
}

model contracts {
  id                    String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  school_id             String
  child_id              String?
  parent_id             String
  group_id              String?
  template_id           String
  content_html          String
  status                String              @default("DRAFT")
  sent_at               DateTime?           @db.Timestamp(6)
  signed_at             DateTime?           @db.Timestamp(6)
  signed_ip             String?
  created_at            DateTime            @default(now()) @db.Timestamp(6)
  school_year_id        String?
  payment_type          String?
  amount                Decimal?            @db.Decimal
  /// Snapshot składowych kwoty (dzieci, stawki, rabaty). Zamrażany przy podpisie.
  amount_breakdown      Json?
  amount_frozen_at      DateTime?           @db.Timestamp(6)
  payment_due_day       Int?
  enrollment_request_id String?
  attachment_1_html     String?
  attachment_2_html     String?
  include_attachment_2  Boolean             @default(false)
  discount_large_family Boolean             @default(false)
  discount_sibling      Boolean             @default(false)
  billing_exempt        Boolean             @default(false)
  /// Numer umowy: ChildID/rok[/n|/An]
  contract_number       String?             @db.VarChar(40)
  contract_children     contract_children[]
  lesson_billing_periods lesson_billing_periods[]
  children              children?           @relation(fields: [child_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groups                groups?             @relation(fields: [group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                 users               @relation(fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schools               schools             @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  school_years          school_years?       @relation(fields: [school_year_id], references: [id], onUpdate: NoAction)
  contract_templates    contract_templates  @relation(fields: [template_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoices              invoices[]
  invoice_items         invoice_items[]
  payments              payments[]
  school_invoice_holds  school_invoice_holds[]

  @@unique([school_id, contract_number], map: "contracts_school_contract_number_key")
  @@index([enrollment_request_id])
  @@index([child_id], map: "idx_contracts_child_id")
  @@index([parent_id], map: "idx_contracts_parent_id")
  @@index([status], map: "idx_contracts_status")
}

model enrollment_requests {
  id                 String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  school_id          String
  parent_first_name  String              @db.VarChar(100)
  parent_last_name   String              @db.VarChar(100)
  parent_email       String              @db.VarChar(255)
  parent_phone       String?             @db.VarChar(50)
  child_first_name   String              @db.VarChar(100)
  child_last_name    String              @db.VarChar(100)
  child_birth_date   DateTime            @db.Date
  preferred_location String?             @db.VarChar(100)
  preferred_days     String?
  notes              String?
  status             enrollment_status   @default(NEW)
  proposed_group_id  String?
  proposed_at        DateTime?           @db.Timestamp(6)
  accepted_at        DateTime?           @db.Timestamp(6)
  user_id            String?
  created_at         DateTime            @default(now()) @db.Timestamp(6)
  rejected_at        DateTime?           @db.Timestamp(6)
  lesson_unit_price  Decimal?            @db.Decimal(10, 2)
  monthly_unit_price Decimal?            @db.Decimal(10, 2)
  yearly_unit_price  Decimal?            @db.Decimal(10, 2)
  /// Staging KDR przed kontem rodzica; po utworzeniu konta kopiowane do parent_profiles
  discount_large_family Boolean          @default(false)
  children           children[]
  contract_children  contract_children[]
  groups             groups?             @relation(fields: [proposed_group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schools            schools             @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users              users?              @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages           messages[]

  @@index([parent_email], map: "idx_enrollment_requests_email")
  @@index([school_id], map: "idx_enrollment_requests_school_id")
  @@index([status], map: "idx_enrollment_requests_status")
}

model group_materials {
  id          String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  group_id    String
  material_id String
  assigned_at DateTime  @default(now()) @db.Timestamp(6)
  groups      groups    @relation(fields: [group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  materials   materials @relation(fields: [material_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([group_id, material_id])
}

model group_students {
  id             String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  school_id      String
  group_id       String
  child_id       String
  enrolled_at    DateTime      @default(dbgenerated("CURRENT_DATE")) @db.Date
  left_at           DateTime?     @db.Date
  school_year_id    String?
  lesson_unit_price Decimal?      @db.Decimal(10, 2)
  monthly_unit_price Decimal?     @db.Decimal(10, 2)
  yearly_unit_price Decimal?      @db.Decimal(10, 2)
  children          children      @relation(fields: [child_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groups            groups        @relation(fields: [group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schools           schools       @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  school_years      school_years? @relation(fields: [school_year_id], references: [id], onUpdate: NoAction)

  @@unique([group_id, child_id, school_year_id])
  @@index([child_id], map: "idx_group_students_child_id")
  @@index([group_id], map: "idx_group_students_group_id")
  @@index([school_id], map: "idx_group_students_school_id")
}

model groups {
  id                     String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  school_id              String
  teacher_id             String
  name                   String                @db.VarChar(255)
  level                  String?               @db.VarChar(100)
  max_students           Int                   @default(12)
  active                 Boolean               @default(true)
  created_at             DateTime              @default(now()) @db.Timestamp(6)
  location_id            String?
  price_monthly          Decimal?              @db.Decimal(10, 2)
  price_yearly           Decimal?              @db.Decimal(10, 2)
  price_per_lesson       Decimal?              @db.Decimal(10, 2)
  teacher_pickup_consent Boolean               @default(false)
  contract_children      contract_children[]
  contracts              contracts[]
  enrollment_requests    enrollment_requests[]
  group_materials        group_materials[]
  group_students         group_students[]
  locations              locations?            @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schools                schools               @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                  users                 @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lessons                lessons[]
  renewal_proposals      renewal_proposals[]
  renewals               renewals[]
  schedule_templates     schedule_templates[]
  subscriptions          subscriptions[]

  @@index([school_id], map: "idx_groups_school_id")
  @@index([teacher_id], map: "idx_groups_teacher_id")
}

model lessons {
  school_id            String
  id                   String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  group_id             String
  teacher_id           String
  location_id          String
  scheduled_at         DateTime            @db.Timestamp(6)
  duration_min         Int                 @default(60)
  status               LessonStatus        @default(SCHEDULED)
  notes                String?
  created_at           DateTime            @default(now()) @db.Timestamp(6)
  cancellation_reason  String?
  school_year_id       String?
  schedule_template_id String?
  attendance           attendance[]
  schools              schools             @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groups               groups              @relation(fields: [group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  locations            locations           @relation(fields: [location_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schedule_templates   schedule_templates? @relation(fields: [schedule_template_id], references: [id], onUpdate: NoAction)
  school_years         school_years?       @relation(fields: [school_year_id], references: [id], onUpdate: NoAction)
  users                users               @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  progress_notes       progress_notes[]

  @@index([group_id], map: "idx_lessons_group_id")
  @@index([schedule_template_id], map: "idx_lessons_schedule_template_id")
  @@index([scheduled_at], map: "idx_lessons_scheduled_at")
  @@index([school_year_id], map: "idx_lessons_school_year_id")
  @@index([school_id], map: "idx_lessons_school_id")
}

model lesson_billing_periods {
  id            String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  school_id     String
  child_id      String
  parent_id     String
  contract_id   String?
  period_month  DateTime  @db.Date
  lessons_count Int?
  amount        Decimal   @db.Decimal(10, 2)
  unit_price    Decimal?  @db.Decimal(10, 2)
  status        String    @default("DRAFT")
  entered_by    String?
  entered_at    DateTime  @default(now()) @db.Timestamp(6)
  notes         String?
  payment_id      String?       @unique
  school_year_id  String?
  children        children      @relation(fields: [child_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contracts       contracts?    @relation(fields: [contract_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_parent    users         @relation("lesson_billing_parent", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_entered   users?        @relation("lesson_billing_entered_by", fields: [entered_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schools         schools       @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  school_years    school_years? @relation(fields: [school_year_id], references: [id], onUpdate: NoAction)
  payments        payments?     @relation(fields: [payment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([child_id, period_month], map: "lesson_billing_periods_child_month_key")
  @@index([school_id, period_month], map: "idx_lesson_billing_school_month")
  @@index([parent_id], map: "idx_lesson_billing_parent")
  @@index([contract_id], map: "idx_lesson_billing_contract")
}

model locations {
  id                 String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  school_id          String
  name               String               @db.VarChar(255)
  address            String?
  active             Boolean              @default(true)
  sort_order         Int                  @default(100)
  is_featured        Boolean              @default(false)
  groups             groups[]
  lessons            lessons[]
  schools            schools              @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schedule_templates schedule_templates[]

  @@index([school_id], map: "idx_locations_school_id")
}

model materials {
  id              String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  school_id       String
  uploaded_by     String
  title           String            @db.VarChar(255)
  type            MaterialType
  url             String
  level           String?           @db.VarChar(100)
  created_at      DateTime          @default(now()) @db.Timestamp(6)
  group_materials group_materials[]
  schools         schools           @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users           users             @relation(fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([school_id], map: "idx_materials_school_id")
}

model messages {
  id                                 String               @id
  school_id                          String?
  parent_id                          String?
  sender_id                          String?
  sender_role                        String?
  enrollment_request_id              String?
  content                            String?
  read_at                            DateTime?            @db.Timestamp(6)
  created_at                         DateTime?            @default(now()) @db.Timestamp(6)
  parent_message_id                  String?
  recipient_id                       String?
  broadcast_id                       String?
  subject                            String?              @db.VarChar(255)
  email_status                       String?              @default("PENDING")
  enrollment_requests                enrollment_requests? @relation(fields: [enrollment_request_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_messages_parent_idTousers    users?               @relation("messages_parent_idTousers", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages                           messages?            @relation("messagesTomessages", fields: [parent_message_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_messages                     messages[]           @relation("messagesTomessages")
  users_messages_recipient_idTousers users?               @relation("messages_recipient_idTousers", fields: [recipient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schools                            schools?             @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_messages_sender_idTousers    users?               @relation("messages_sender_idTousers", fields: [sender_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([broadcast_id], map: "idx_messages_broadcast")
  @@index([parent_message_id], map: "idx_messages_parent")
  @@index([recipient_id], map: "idx_messages_recipient")
}

model parent_profiles {
  id                    String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  user_id               String
  school_id             String
  address               String?
  city                  String?
  zip_code              String?   @db.VarChar(10)
  created_at            DateTime? @default(now()) @db.Timestamp(6)
  updated_at            DateTime? @default(now()) @db.Timestamp(6)
  company_name          String?   @db.VarChar(255)
  nip                   String?   @db.VarChar(20)
  pesel                 String?   @db.VarChar(11)
  discount_large_family Boolean   @default(false)
  schools               schools   @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                 users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model payments {
  id             String        @id
  school_id      String?
  child_id       String?
  parent_id      String?
  contract_id    String?
  amount         Decimal?      @db.Decimal
  status         String?
  due_date       DateTime?     @db.Date
  paid_at        DateTime?     @db.Timestamp(6)
  period_month   DateTime?     @db.Date
  description    String?
  created_at     DateTime?     @default(now()) @db.Timestamp(6)
  school_year_id String?
  children       children?     @relation(fields: [child_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contracts      contracts?    @relation(fields: [contract_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users          users?        @relation(fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schools        schools?      @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  school_years   school_years? @relation(fields: [school_year_id], references: [id], onUpdate: NoAction)
  lesson_billing_periods lesson_billing_periods?
  invoices       invoices?
  bank_transfers bank_transfers[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model progress_notes {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  child_id   String
  teacher_id String
  lesson_id  String?
  note       String
  rating     Int?
  created_at DateTime @default(now()) @db.Timestamp(6)
  children   children @relation(fields: [child_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lessons    lessons? @relation(fields: [lesson_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users      users    @relation(fields: [teacher_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([child_id], map: "idx_progress_notes_child_id")
  @@index([teacher_id], map: "idx_progress_notes_teacher_id")
}

model renewal_proposals {
  id                String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  school_id         String
  renewal_id        String    @unique(map: "idx_renewal_proposals_one_pending", where: raw("(status = 'PENDING'::text)"))
  group_id          String
  proposed_by       String
  proposed_at       DateTime  @default(now()) @db.Timestamp(6)
  status            String    @default("PENDING")
  responded_at      DateTime? @db.Timestamp(6)
  rejection_comment String?
  created_at        DateTime  @default(now()) @db.Timestamp(6)
  groups            groups    @relation(fields: [group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users             users     @relation(fields: [proposed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  renewals          renewals  @relation(fields: [renewal_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  schools           schools   @relation(fields: [school_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([renewal_id], map: "idx_renewal_proposals_renewal")
}

model renewals {
  id                String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  school_id         String
  child_id          String
  parent_id         String
  season            String             @db.VarChar(20)
  status            String             @default("PENDING_CONFIRMATION")
  initiated_at      DateTime           @default(now()) @db.Timestamp(6)
  confirmed_at      DateTime?          @db.Timestamp(6)
  proposed_group_id String?
