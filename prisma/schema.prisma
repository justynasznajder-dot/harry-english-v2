  caption   String?  @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId], name: "marketing_gallery_school_id_idx")
  @@map("marketing_gallery")
}

model MarketingFaq {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  schoolId  String   @map("school_id")
  question  String   @db.Text
  answer    String   @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId], name: "marketing_faq_school_id_idx")
  @@map("marketing_faq")
}

model MarketingTestimonial {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  schoolId   String   @map("school_id")
  authorName String   @map("author_name") @db.Text
  body       String   @db.Text
  sortLabel  String?  @map("sort_label") @db.Text
  rating     Int?     @default(5) @db.SmallInt
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId], name: "marketing_testimonial_school_id_idx")
  @@map("marketing_testimonial")
}
