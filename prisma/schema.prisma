// ============================================================
// HarryEnglish — Prisma Schema
// Generator ID: CUID2 (@paralleldrive/cuid2)
// Provider: PostgreSQL (Neon)
// ============================================================

generator client {
  provider = "prisma-client-js"
}


// ============================================================
// SZKOŁY (multi-tenant — school_id wszędzie)
// ============================================================

model School {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("Europe/Warsaw")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  users         User[]
  children      Child[]
  groups        Group[]
  locations     Location[]
  materials     Material[]
  subscriptions Subscription[]
  announcements Announcement[]
  rewards       Reward[]
  messages      Message[]
  payments      Payment[]
  attendances   Attendance[] // brak bezpośredniego FK school_id w tabeli attendance
  contracts     Contract[]
  contractTemplates ContractTemplate[]
  parentProfiles    ParentProfile[]
  enrollmentRequests EnrollmentRequest[]
  schoolYears   SchoolYear[]
  schoolHolidays SchoolHoliday[]
  renewals      Renewal[]
  renewalProposals RenewalProposal[]

  @@map("schools")
}

model SchoolYear {
  id        String   @id @default(cuid())
  schoolId  String   @map("school_id")
  name      String
  dateFrom  DateTime @map("date_from")
  dateTo    DateTime @map("date_to")
  active    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  school          School           @relation(fields: [schoolId], references: [id])
  holidays        SchoolHoliday[]
  groups          Group[]
  lessons         Lesson[]
  subscriptions   Subscription[]
  scheduleTemplates ScheduleTemplate[]
  groupStudents   GroupStudent[]

  @@index([schoolId])
  @@map("school_years")
}

model SchoolHoliday {
  id           String    @id @default(cuid())
  schoolId     String    @map("school_id")
  schoolYearId String?  @map("school_year_id")
  name         String
  dateFrom     DateTime  @map("date_from")
  dateTo       DateTime  @map("date_to")
  type         String    @default("HOLIDAY")
  createdAt    DateTime  @default(now()) @map("created_at")

  school     School      @relation(fields: [schoolId], references: [id])
  schoolYear SchoolYear? @relation(fields: [schoolYearId], references: [id])

  @@index([schoolId])
  @@index([schoolYearId])
  @@map("school_holidays")
}

// ============================================================
// UŻYTKOWNICY DOROŚLI (admin, teacher, parent)
// ============================================================

model User {
  id           String    @id @default(cuid())
  schoolId     String    @map("school_id")
  email        String
  passwordHash String    @map("password_hash")
  /// ADMIN | MANAGER | TEACHER | PARENT | CHILD (TEXT w PostgreSQL)
  role         String    @default("PARENT") @db.Text
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  phone        String?
  active       Boolean   @default(true)
  confirmed    Boolean   @default(false)
  accessLevel  String    @default("PENDING") @map("access_level") @db.Text

  // Reset hasła
  resetToken       String?   @map("reset_token")
  resetTokenExpiry DateTime? @map("reset_token_expiry")

  mustChangePassword Boolean @default(false) @map("must_change_password")

  // Soft-delete
  resignationDate DateTime? @map("resignation_date")

  lastLogin DateTime? @map("last_login")
  createdAt DateTime  @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id])

  children      Child[]         @relation("ParentChildren")
  taughtGroups  Group[]         @relation("TeacherGroups")
  uploadedMaterials Material[]  @relation("UploadedMaterials")
  progressNotes ProgressNote[]  @relation("TeacherNotes")
  sentMessages       Message[]  @relation("SenderMessages")
  parentMessages     Message[]  @relation("ParentMessages")
  receivedMessages   Message[]  @relation("RecipientMessages")
  enrollmentRequests EnrollmentRequest[]
  contracts          Contract[]
  payments           Payment[]
  announcements Announcement[]
  parentProfile ParentProfile?
  renewals      Renewal[]
  renewalProposalsAuthored RenewalProposal[] @relation("RenewalProposalProposedBy")

  @@unique([schoolId, email])
  @@index([schoolId])
  @@index([email])
  @@index([resetToken])
  @@index([role])
  @@map("users")
}

// ============================================================
// DZIECI (osobne konta z loginem)
// ============================================================

model Child {
  id        String   @id @default(cuid())
  schoolId  String   @map("school_id")
  parentId  String   @map("parent_id")
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  birthDate DateTime @map("birth_date") @db.Date
  avatarUrl String?  @map("avatar_url")
  xpTotal   Int      @default(0) @map("xp_total")
  active    Boolean  @default(true)

  // Soft-delete / rezygnacja
  resignationRequested Boolean   @default(false) @map("resignation_requested")
  resignationReason    String?   @map("resignation_reason")
  resignationDate      DateTime? @map("resignation_date")

  createdAt DateTime @default(now()) @map("created_at")
  confirmed           Boolean  @default(false)
  enrollmentRequestId String?  @map("enrollment_request_id")

  school School @relation(fields: [schoolId], references: [id])
  parent User   @relation("ParentChildren", fields: [parentId], references: [id])

  preferredLocationId String?   @map("preferred_location_id")
  preferredLocation   Location? @relation("ChildPreferredLocation", fields: [preferredLocationId], references: [id])

  childAuth     ChildAuth?
  groupStudents GroupStudent[]
  attendance    Attendance[]
  progressNotes ProgressNote[]
  childRewards  ChildReward[]
  payments      Payment[]
  renewals      Renewal[]

  @@index([schoolId])
  @@index([parentId])
  @@map("children")
}

// Osobne dane logowania dziecka
model ChildAuth {
  id           String    @id @default(cuid())
  childId      String    @unique @map("child_id")
  username     String    @unique
  passwordHash String    @map("password_hash")
  lastLogin    DateTime? @map("last_login")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@map("child_auth")
}

// ============================================================
// LOKALIZACJE / SALE
// ============================================================

model Location {
  id       String  @id @default(cuid())
  schoolId String  @map("school_id")
  name     String
  address  String?
  active   Boolean @default(true)

  school School @relation(fields: [schoolId], references: [id])

  groups            Group[]
  scheduleTemplates ScheduleTemplate[]
  lessons           Lesson[]
  preferredByChildren Child[] @relation("ChildPreferredLocation")

  @@index([schoolId])
  @@map("locations")
}

// ============================================================
// GRUPY
// ============================================================

model Group {
  id          String  @id @default(cuid())
  schoolId    String  @map("school_id")
  schoolYearId String? @map("school_year_id")
  locationId  String?  @map("location_id")
  teacherId   String  @map("teacher_id")
  name         String
  level        String?
  maxStudents  Int      @default(12) @map("max_students")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  /// Stawka miesięczna (domyślna dla umów)
  priceMonthly Decimal? @map("price_monthly") @db.Decimal(10, 2)
  /// Stawka roczna (opcja taniej)
  priceYearly  Decimal? @map("price_yearly") @db.Decimal(10, 2)

  school     School      @relation(fields: [schoolId], references: [id])
  schoolYear SchoolYear? @relation(fields: [schoolYearId], references: [id])
  location  Location?  @relation(fields: [locationId], references: [id])
  teacher User   @relation("TeacherGroups", fields: [teacherId], references: [id])

  groupStudents     GroupStudent[]
  scheduleTemplates ScheduleTemplate[]
  lessons           Lesson[]
  groupMaterials    GroupMaterial[]
  subscriptions     Subscription[]
  renewals          Renewal[]
  renewalProposals  RenewalProposal[]

  @@index([schoolId])
  @@index([teacherId])
  @@map("groups")
}

// Uczniowie w grupie (many-to-many)
model GroupStudent {
  id           String    @id @default(cuid())
  groupId      String    @map("group_id")
  childId      String    @map("child_id")
  enrolledAt   DateTime  @default(now()) @map("enrolled_at") @db.Date
  leftAt       DateTime? @map("left_at") @db.Date
  schoolYearId String?   @map("school_year_id")

  group      Group       @relation(fields: [groupId], references: [id])
  child      Child       @relation(fields: [childId], references: [id])
  schoolYear SchoolYear? @relation(fields: [schoolYearId], references: [id])

  @@unique([groupId, childId])
  @@index([groupId])
  @@index([childId])
  @@map("group_students")
}

// ============================================================
// HARMONOGRAM
// ============================================================

model ScheduleTemplate {
  id           String   @id @default(cuid())
  groupId      String   @map("group_id")
  locationId   String   @map("location_id")
  dayOfWeek    Int      @map("day_of_week")
  startTime    DateTime @map("start_time") @db.Time
  durationMin  Int      @default(60) @map("duration_min")
  schoolYearId String?  @map("school_year_id")

  group      Group       @relation(fields: [groupId], references: [id])
  location   Location    @relation(fields: [locationId], references: [id])
  schoolYear SchoolYear? @relation(fields: [schoolYearId], references: [id])

  @@index([groupId])
  @@map("schedule_templates")
}

model Lesson {
  id           String       @id @default(cuid())
  groupId      String       @map("group_id")
  schoolYearId String?      @map("school_year_id")
  teacherId    String       @map("teacher_id")
  locationId   String       @map("location_id")
  scheduledAt  DateTime     @map("scheduled_at")
  durationMin  Int          @default(60) @map("duration_min")
  status       LessonStatus @default(SCHEDULED)
  notes        String?
  cancellationReason String? @map("cancellation_reason")
  createdAt    DateTime     @default(now()) @map("created_at")

  group      Group       @relation(fields: [groupId], references: [id])
  schoolYear SchoolYear? @relation(fields: [schoolYearId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  attendance    Attendance[]
  progressNotes ProgressNote[]

  @@index([groupId])
  @@index([scheduledAt])
  @@map("lessons")
}

enum LessonStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

// ============================================================
// OBECNOŚCI
// ============================================================

model Attendance {
  id       String           @id @default(cuid())
  lessonId String           @map("lesson_id")
  childId  String           @map("child_id")
  /// USER-DEFINED ENUM w bazie (AttendanceStatus): PRESENT | ABSENT | EXCUSED | LATE
  status   AttendanceStatus @default(PRESENT)
  note     String?

  lesson Lesson @relation(fields: [lessonId], references: [id])
  child  Child  @relation(fields: [childId], references: [id])

  @@unique([lessonId, childId])
  @@index([lessonId])
  @@index([childId])
  @@map("attendance")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  LATE
}

// ============================================================
// MATERIAŁY
// ============================================================

model Material {
  id           String       @id @default(cuid())
  schoolId     String       @map("school_id")
  uploadedById String       @map("uploaded_by")
  title        String
  type         MaterialType
  url          String
  level        String?
  createdAt    DateTime     @default(now()) @map("created_at")

  school     School @relation(fields: [schoolId], references: [id])
  uploadedBy User   @relation("UploadedMaterials", fields: [uploadedById], references: [id])

  groupMaterials GroupMaterial[]

  @@index([schoolId])
  @@map("materials")
}

enum MaterialType {
  PDF
  VIDEO
  AUDIO
  IMAGE
  LINK
  EXERCISE
}

model GroupMaterial {
  id         String   @id @default(cuid())
  groupId    String   @map("group_id")
  materialId String   @map("material_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  group    Group    @relation(fields: [groupId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  @@unique([groupId, materialId])
  @@map("group_materials")
}

// ============================================================
// POSTĘPY
// ============================================================

model ProgressNote {
  id        String   @id @default(cuid())
  childId   String   @map("child_id")
  teacherId String   @map("teacher_id")
  lessonId  String?  @map("lesson_id")
  note      String
  rating    Int?
  createdAt DateTime @default(now()) @map("created_at")

  child   Child   @relation(fields: [childId], references: [id])
  teacher User    @relation("TeacherNotes", fields: [teacherId], references: [id])
  lesson  Lesson? @relation(fields: [lessonId], references: [id])

  @@index([childId])
  @@index([teacherId])
  @@map("progress_notes")
}

// ============================================================
// PŁATNOŚCI
// ============================================================

model Subscription {
  id            String             @id @default(cuid())
  schoolId      String             @map("school_id")
  schoolYearId  String?            @map("school_year_id")
  parentId      String             @map("parent_id")
  childId       String             @map("child_id")
  groupId       String             @map("group_id")
  status        SubscriptionStatus @default(ACTIVE)
  priceCents    Int                @map("price_cents")
  billingPeriod String             @default("MONTHLY") @map("billing_period")
  validFrom     DateTime           @map("valid_from") @db.Date
  validTo       DateTime?          @map("valid_to") @db.Date
  createdAt     DateTime           @default(now()) @map("created_at")

  school     School      @relation(fields: [schoolId], references: [id])
  schoolYear SchoolYear? @relation(fields: [schoolYearId], references: [id])

  @@index([schoolId])
  @@index([parentId])
  @@index([childId])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

model Payment {
  id          String    @id @default(cuid())
  schoolId    String    @map("school_id")
  childId     String    @map("child_id")
  parentId    String    @map("parent_id")
  contractId  String    @map("contract_id")
  amount      Decimal   @db.Decimal(10, 2)
  /// PAID | PENDING | OVERDUE
  status      String    @default("PENDING") @db.Text
  dueDate     DateTime  @map("due_date") @db.Date
  paidAt      DateTime? @map("paid_at")
  periodMonth DateTime  @map("period_month") @db.Date
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")

  school   School   @relation(fields: [schoolId], references: [id])
  child    Child    @relation(fields: [childId], references: [id])
  parent   User     @relation(fields: [parentId], references: [id])
  contract Contract @relation(fields: [contractId], references: [id])

  @@index([schoolId])
  @@index([childId])
  @@index([parentId])
  @@index([contractId])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

// ============================================================
// KOMUNIKACJA
// ============================================================

model Message {
  id                  String    @id @default(cuid())
  schoolId            String    @map("school_id")
  parentId            String?   @map("parent_id")
  senderId            String    @map("sender_id")
  senderRole          String    @map("sender_role") @db.Text
  recipientId         String?   @map("recipient_id")
  parentMessageId     String?   @map("parent_message_id")
  broadcastId         String?   @map("broadcast_id")
  subject             String?   @db.VarChar(255)
  emailStatus         String?   @default("PENDING") @map("email_status") @db.Text
  enrollmentRequestId String?   @map("enrollment_request_id")
  content             String    @db.Text
  readAt              DateTime? @map("read_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  school            School             @relation(fields: [schoolId], references: [id])
  parent            User?              @relation("ParentMessages", fields: [parentId], references: [id])
  sender            User               @relation("SenderMessages", fields: [senderId], references: [id])
  recipient         User?              @relation("RecipientMessages", fields: [recipientId], references: [id])
  parentMessage     Message?           @relation("MessageThread", fields: [parentMessageId], references: [id])
  replies           Message[]          @relation("MessageThread")
  enrollmentRequest EnrollmentRequest? @relation(fields: [enrollmentRequestId], references: [id])

  @@index([schoolId])
  @@index([parentId])
  @@index([senderId])
  @@index([recipientId])
  @@index([parentMessageId])
  @@index([broadcastId])
  @@index([enrollmentRequestId])
  @@map("messages")
}

model EnrollmentRequest {
  id               String    @id @default(cuid())
  schoolId         String    @map("school_id")
  userId           String?   @map("user_id")
  parentFirstName  String    @map("parent_first_name")
  parentLastName   String    @map("parent_last_name")
  parentEmail      String    @map("parent_email")
  parentPhone      String?   @map("parent_phone")
  childFirstName   String    @map("child_first_name")
  childLastName    String    @map("child_last_name")
  childBirthDate   DateTime  @map("child_birth_date") @db.Date
  preferredLocation String?  @map("preferred_location")
  preferredDays    String?   @map("preferred_days")
  notes            String?
  status           String    @default("NEW") @db.Text
  proposedGroupId  String?   @map("proposed_group_id")
  proposedAt       DateTime? @map("proposed_at")
  acceptedAt       DateTime? @map("accepted_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  school    School    @relation(fields: [schoolId], references: [id])
  parent    User?     @relation(fields: [userId], references: [id])
  messages  Message[]
  contracts Contract[]

  @@index([schoolId])
  @@index([userId])
  @@index([proposedGroupId])
  @@map("enrollment_requests")
}

model Contract {
  id                  String    @id @default(cuid())
  schoolId            String    @map("school_id")
  childId             String?   @map("child_id")
  parentId            String    @map("parent_id")
  groupId             String?   @map("group_id")
  templateId          String?   @map("template_id")
  enrollmentRequestId String?   @map("enrollment_request_id")
  contentHtml         String    @map("content_html")
  attachment1Html     String?   @map("attachment_1_html") @db.Text
  attachment2Html     String?   @map("attachment_2_html") @db.Text
  includeAttachment2  Boolean   @default(false) @map("include_attachment_2")
  status              String    @default("SENT") @db.Text
  sentAt              DateTime? @map("sent_at")
  signedAt            DateTime? @map("signed_at")
  signedIp            String?   @map("signed_ip")
  /// MONTHLY | YEARLY
  paymentType         String?   @map("payment_type") @db.Text
  amount              Decimal?  @db.Decimal(10, 2)
  /// TRUE jeśli manager nadpisał kwotę ręcznie (odchylenie od cennika grupy)
  priceOverride       Boolean   @default(false) @map("price_override")
  paymentDueDay       Int?      @map("payment_due_day")
  createdAt           DateTime  @default(now()) @map("created_at")
  schoolYearId        String?   @map("school_year_id")

  school            School             @relation(fields: [schoolId], references: [id])
  child             Child?             @relation(fields: [childId], references: [id])
  parent            User               @relation(fields: [parentId], references: [id])
  enrollmentRequest EnrollmentRequest? @relation(fields: [enrollmentRequestId], references: [id])
  payments          Payment[]

  @@index([schoolId])
  @@index([childId])
  @@index([parentId])
  @@index([enrollmentRequestId])
  @@map("contracts")
}

model ContractTemplate {
  id          String    @id @default(cuid())
  schoolId    String    @map("school_id")
  name        String
  contentHtml String    @map("content_html") @db.Text
  /// CONTRACT | ATTACHMENT_1 | ATTACHMENT_2
  templateKind String   @default("CONTRACT") @map("template_kind") @db.Text
  active      Boolean   @default(true)
  schoolYear  String?   @map("school_year") @db.VarChar(9)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime? @map("updated_at")

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@map("contract_templates")
}

model ParentProfile {
  id        String    @id @default(cuid())
  userId    String    @unique @map("user_id")
  schoolId  String    @map("school_id")
  address     String?
  city        String?
  zipCode     String?   @map("zip_code")
  /// Wypełnione jeśli faktura na firmę
  companyName String?   @map("company_name")
  nip         String?   @map("nip")
  /// Wypełnione jeśli osoba prywatna
  pesel       String?   @map("pesel")
  createdAt   DateTime? @default(now()) @map("created_at")
  updatedAt   DateTime? @map("updated_at")

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@map("parent_profiles")
}

model Announcement {
  id          String    @id @default(cuid())
  schoolId    String    @map("school_id")
  authorId    String    @map("author_id")
  title       String
  body        String
  targetRole  String?   @map("target_role")
  publishedAt DateTime  @default(now()) @map("published_at")
  expiresAt   DateTime? @map("expires_at")

  school School @relation(fields: [schoolId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  @@index([schoolId])
  @@map("announcements")
}

// ============================================================
// SYSTEM NAGRÓD
// ============================================================

model Reward {
  id       String     @id @default(cuid())
  schoolId String     @map("school_id")
  name     String
  type     RewardType
  xpCost   Int        @map("xp_cost")
  assetUrl String?    @map("asset_url")

  school School @relation(fields: [schoolId], references: [id])

  childRewards ChildReward[]

  @@index([schoolId])
  @@map("rewards")
}

enum RewardType {
  AVATAR
  BADGE
  ITEM
}

model ChildReward {
  id       String   @id @default(cuid())
  childId  String   @map("child_id")
  rewardId String   @map("reward_id")
  earnedAt DateTime @default(now()) @map("earned_at")

  child  Child  @relation(fields: [childId], references: [id])
  reward Reward @relation(fields: [rewardId], references: [id])

  @@index([childId])
  @@map("child_rewards")
}

// ============================================================
// ODNOWIENIA (renewals / renewal_proposals)
// ============================================================

/// Wniosek o odnowienie zapisu dziecka na kolejny sezon
model Renewal {
  id             String    @id @default(cuid())
  schoolId       String    @map("school_id")
  childId        String    @map("child_id")
  parentId       String    @map("parent_id")
  season         String    @db.VarChar
  /// PENDING_CONFIRMATION | CONFIRMED | REJECTED | CANCELLED
  status         String    @default("PENDING_CONFIRMATION") @db.Text
  initiatedAt    DateTime  @default(now()) @map("initiated_at")
  confirmedAt    DateTime? @map("confirmed_at")
  proposedGroupId String?  @map("proposed_group_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  school         School            @relation(fields: [schoolId], references: [id])
  child          Child             @relation(fields: [childId], references: [id])
  parent         User              @relation(fields: [parentId], references: [id])
  proposedGroup  Group?            @relation(fields: [proposedGroupId], references: [id])
  renewalProposals RenewalProposal[]

  @@index([schoolId])
  @@index([childId])
  @@index([parentId])
  @@map("renewals")
}

/// Historia propozycji grup w procesie odnowienia (PENDING → ACCEPTED | REJECTED)
model RenewalProposal {
  id               String    @id @default(cuid())
  schoolId         String    @map("school_id")
  renewalId        String    @map("renewal_id")
  groupId          String    @map("group_id")
  proposedByUserId String    @map("proposed_by")
  proposedAt       DateTime  @default(now()) @map("proposed_at")
  /// PENDING | ACCEPTED | REJECTED
  status           String    @default("PENDING") @db.Text
  respondedAt      DateTime? @map("responded_at")
  rejectionComment String?   @map("rejection_comment") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")

  school     School  @relation(fields: [schoolId], references: [id])
  renewal    Renewal @relation(fields: [renewalId], references: [id])
  group      Group   @relation(fields: [groupId], references: [id])
  proposedBy User    @relation("RenewalProposalProposedBy", fields: [proposedByUserId], references: [id])

  @@index([schoolId])
