// ============================================================
// HarryEnglish — Prisma Schema
// Generator ID: CUID2 (@paralleldrive/cuid2)
// Provider: PostgreSQL (Neon)
// ============================================================

generator client {
  provider = "prisma-client-js"
}


// ============================================================
// SZKOŁY (multi-tenant — school_id wszędzie)
// ============================================================

model School {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  timezone  String   @default("Europe/Warsaw")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  users         User[]
  children      Child[]
  groups        Group[]
  locations     Location[]
  materials     Material[]
  subscriptions Subscription[]
  announcements Announcement[]
  rewards       Reward[]
  messages      Message[]
  schoolYears   SchoolYear[]
  schoolHolidays SchoolHoliday[]

  @@map("schools")
}

model SchoolYear {
  id        String   @id @default(cuid())
  schoolId  String   @map("school_id")
  name      String
  dateFrom  DateTime @map("date_from")
  dateTo    DateTime @map("date_to")
  active    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  school          School           @relation(fields: [schoolId], references: [id])
  holidays        SchoolHoliday[]
  groups          Group[]
  lessons         Lesson[]
  subscriptions   Subscription[]

  @@index([schoolId])
  @@map("school_years")
}

model SchoolHoliday {
  id           String    @id @default(cuid())
  schoolId     String    @map("school_id")
  schoolYearId String?  @map("school_year_id")
  name         String
  dateFrom     DateTime  @map("date_from")
  dateTo       DateTime  @map("date_to")
  type         String    @default("HOLIDAY")
  createdAt    DateTime  @default(now()) @map("created_at")

  school     School      @relation(fields: [schoolId], references: [id])
  schoolYear SchoolYear? @relation(fields: [schoolYearId], references: [id])

  @@index([schoolId])
  @@index([schoolYearId])
  @@map("school_holidays")
}

// ============================================================
// UŻYTKOWNICY DOROŚLI (admin, teacher, parent)
// ============================================================

model User {
  id           String    @id @default(cuid())
  schoolId     String    @map("school_id")
  email        String
  passwordHash String    @map("password_hash")
  /// ADMIN | MANAGER | TEACHER | PARENT | CHILD (TEXT w PostgreSQL)
  role         String    @default("PARENT") @db.Text
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  phone        String?
  active       Boolean   @default(true)
  confirmed    Boolean   @default(false)

  // Reset hasła
  resetToken       String?   @map("reset_token")
  resetTokenExpiry DateTime? @map("reset_token_expiry")

  // Soft-delete
  resignationDate DateTime? @map("resignation_date")

  lastLogin DateTime? @map("last_login")
  createdAt DateTime  @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id])

  children      Child[]         @relation("ParentChildren")
  taughtGroups  Group[]         @relation("TeacherGroups")
  uploadedMaterials Material[]  @relation("UploadedMaterials")
  progressNotes ProgressNote[]  @relation("TeacherNotes")
  sentMessages     Message[]    @relation("SentMessages")
  receivedMessages Message[]    @relation("ReceivedMessages")
  announcements Announcement[]

  @@unique([schoolId, email])
  @@index([schoolId])
  @@index([email])
  @@index([resetToken])
  @@index([role])
  @@map("users")
}

// ============================================================
// DZIECI (osobne konta z loginem)
// ============================================================

model Child {
  id        String   @id @default(cuid())
  schoolId  String   @map("school_id")
  parentId  String   @map("parent_id")
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  birthDate DateTime @map("birth_date") @db.Date
  avatarUrl String?  @map("avatar_url")
  xpTotal   Int      @default(0) @map("xp_total")
  active    Boolean  @default(true)

  // Soft-delete / rezygnacja
  resignationRequested Boolean   @default(false) @map("resignation_requested")
  resignationReason    String?   @map("resignation_reason")
  resignationDate      DateTime? @map("resignation_date")

  createdAt DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id])
  parent User   @relation("ParentChildren", fields: [parentId], references: [id])

  preferredLocationId String?   @map("preferred_location_id")
  preferredLocation   Location? @relation("ChildPreferredLocation", fields: [preferredLocationId], references: [id])

  childAuth     ChildAuth?
  groupStudents GroupStudent[]
  attendance    Attendance[]
  progressNotes ProgressNote[]
  childRewards  ChildReward[]

  @@index([schoolId])
  @@index([parentId])
  @@map("children")
}

// Osobne dane logowania dziecka
model ChildAuth {
  id           String    @id @default(cuid())
  childId      String    @unique @map("child_id")
  username     String    @unique
  passwordHash String    @map("password_hash")
  lastLogin    DateTime? @map("last_login")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@map("child_auth")
}

// ============================================================
// LOKALIZACJE / SALE
// ============================================================

model Location {
  id       String  @id @default(cuid())
  schoolId String  @map("school_id")
  name     String
  address  String?
  active   Boolean @default(true)

  school School @relation(fields: [schoolId], references: [id])

  scheduleTemplates ScheduleTemplate[]
  lessons           Lesson[]
  preferredByChildren Child[] @relation("ChildPreferredLocation")

  @@index([schoolId])
  @@map("locations")
}

// ============================================================
// GRUPY
// ============================================================

model Group {
  id          String  @id @default(cuid())
  schoolId    String  @map("school_id")
  schoolYearId String? @map("school_year_id")
  teacherId   String  @map("teacher_id")
  name        String
  level       String?
  maxStudents Int     @default(12) @map("max_students")
  active      Boolean @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  school     School      @relation(fields: [schoolId], references: [id])
  schoolYear SchoolYear? @relation(fields: [schoolYearId], references: [id])
  teacher User   @relation("TeacherGroups", fields: [teacherId], references: [id])

  groupStudents     GroupStudent[]
  scheduleTemplates ScheduleTemplate[]
  lessons           Lesson[]
  groupMaterials    GroupMaterial[]
  subscriptions     Subscription[]

  @@index([schoolId])
  @@index([teacherId])
  @@map("groups")
}

// Uczniowie w grupie (many-to-many)
model GroupStudent {
  id         String    @id @default(cuid())
  groupId    String    @map("group_id")
  childId    String    @map("child_id")
  enrolledAt DateTime  @default(now()) @map("enrolled_at") @db.Date
  leftAt     DateTime? @map("left_at") @db.Date

  group Group @relation(fields: [groupId], references: [id])
  child Child @relation(fields: [childId], references: [id])

  @@unique([groupId, childId])
  @@index([groupId])
  @@index([childId])
  @@map("group_students")
}

// ============================================================
// HARMONOGRAM
// ============================================================

// Stały harmonogram tygodniowy (np. zawsze środa 17:00)
model ScheduleTemplate {
  id          String   @id @default(cuid())
  groupId     String   @map("group_id")
  locationId  String   @map("location_id")
  dayOfWeek   Int      @map("day_of_week") // 1=pon, 7=niedz
  startTime   DateTime @map("start_time") @db.Time
  durationMin Int      @default(60) @map("duration_min")

  group    Group    @relation(fields: [groupId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@index([groupId])
  @@map("schedule_templates")
}

// Konkretne zajęcia (mogą być tworzone z szablonu lub ręcznie)
model Lesson {
  id           String       @id @default(cuid())
  groupId      String       @map("group_id")
  schoolYearId String?      @map("school_year_id")
  teacherId    String       @map("teacher_id")
  locationId   String       @map("location_id")
  scheduledAt  DateTime     @map("scheduled_at")
  durationMin  Int          @default(60) @map("duration_min")
  status       LessonStatus @default(SCHEDULED)
  notes        String?
  createdAt    DateTime     @default(now()) @map("created_at")

  group      Group       @relation(fields: [groupId], references: [id])
  schoolYear SchoolYear? @relation(fields: [schoolYearId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  attendance    Attendance[]
  progressNotes ProgressNote[]

  @@index([groupId])
  @@index([scheduledAt])
  @@map("lessons")
}

enum LessonStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

// ============================================================
// OBECNOŚCI
// ============================================================

model Attendance {
  id       String           @id @default(cuid())
  lessonId String           @map("lesson_id")
  childId  String           @map("child_id")
  status   AttendanceStatus @default(PRESENT)
  note     String?

  lesson Lesson @relation(fields: [lessonId], references: [id])
  child  Child  @relation(fields: [childId], references: [id])

  @@unique([lessonId, childId])
  @@index([lessonId])
  @@index([childId])
  @@map("attendance")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
  LATE
}

// ============================================================
// MATERIAŁY
// ============================================================

model Material {
  id           String       @id @default(cuid())
  schoolId     String       @map("school_id")
  uploadedById String       @map("uploaded_by")
  title        String
  type         MaterialType
  url          String
  level        String?
  createdAt    DateTime     @default(now()) @map("created_at")

  school     School @relation(fields: [schoolId], references: [id])
  uploadedBy User   @relation("UploadedMaterials", fields: [uploadedById], references: [id])

  groupMaterials GroupMaterial[]

  @@index([schoolId])
  @@map("materials")
}

enum MaterialType {
  PDF
  VIDEO
  AUDIO
  IMAGE
  LINK
  EXERCISE
}

// Materiały przypisane do grupy
model GroupMaterial {
  id         String   @id @default(cuid())
  groupId    String   @map("group_id")
  materialId String   @map("material_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  group    Group    @relation(fields: [groupId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  @@unique([groupId, materialId])
  @@map("group_materials")
}

// ============================================================
// POSTĘPY
// ============================================================

model ProgressNote {
  id        String   @id @default(cuid())
  childId   String   @map("child_id")
  teacherId String   @map("teacher_id")
  lessonId  String?  @map("lesson_id")
  note      String
  rating    Int?     // 1-5
  createdAt DateTime @default(now()) @map("created_at")

  child   Child   @relation(fields: [childId], references: [id])
  teacher User    @relation("TeacherNotes", fields: [teacherId], references: [id])
  lesson  Lesson? @relation(fields: [lessonId], references: [id])

  @@index([childId])
  @@index([teacherId])
  @@map("progress_notes")
}

// ============================================================
// PŁATNOŚCI
// ============================================================

model Subscription {
  id            String             @id @default(cuid())
  schoolId      String             @map("school_id")
  schoolYearId  String?            @map("school_year_id")
  parentId      String             @map("parent_id")
  childId       String             @map("child_id")
  groupId       String             @map("group_id")
  status        SubscriptionStatus @default(ACTIVE)
  priceCents    Int                @map("price_cents")
  billingPeriod String             @default("MONTHLY") @map("billing_period")
  validFrom     DateTime           @map("valid_from") @db.Date
  validTo       DateTime?          @map("valid_to") @db.Date
  createdAt     DateTime           @default(now()) @map("created_at")

  school     School      @relation(fields: [schoolId], references: [id])
  schoolYear SchoolYear? @relation(fields: [schoolYearId], references: [id])

  payments Payment[]

  @@index([schoolId])
  @@index([parentId])
  @@index([childId])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

model Payment {
  id             String        @id @default(cuid())
  subscriptionId String        @map("subscription_id")
  amountCents    Int           @map("amount_cents")
  currency       String        @default("PLN")
  status         PaymentStatus @default(PENDING)
  method         String?
  paidAt         DateTime?     @map("paid_at")
  dueAt          DateTime      @map("due_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@map("payments")
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

// ============================================================
// KOMUNIKACJA
// ============================================================

// Wiadomości 1:1
model Message {
  id          String   @id @default(cuid())
  schoolId    String   @map("school_id")
  senderId    String   @map("sender_id")
  recipientId String   @map("recipient_id")
  subject     String
  body        String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  school    School @relation(fields: [schoolId], references: [id])
  sender    User   @relation("SentMessages", fields: [senderId], references: [id])
  recipient User   @relation("ReceivedMessages", fields: [recipientId], references: [id])

  @@index([schoolId])
  @@index([recipientId])
  @@map("messages")
}

// Ogłoszenia (broadcast do roli)
model Announcement {
  id          String    @id @default(cuid())
  schoolId    String    @map("school_id")
  authorId    String    @map("author_id")
  title       String
  body        String
  targetRole  String?   @map("target_role") // null = wszyscy
  publishedAt DateTime  @default(now()) @map("published_at")
  expiresAt   DateTime? @map("expires_at")

  school School @relation(fields: [schoolId], references: [id])
  author User   @relation(fields: [authorId], references: [id])

  @@index([schoolId])
  @@map("announcements")
}

// ============================================================
// SYSTEM NAGRÓD
// ============================================================

model Reward {
  id       String     @id @default(cuid())
  schoolId String     @map("school_id")
  name     String
  type     RewardType
  xpCost   Int        @map("xp_cost")
  assetUrl String?    @map("asset_url")

  school School @relation(fields: [schoolId], references: [id])

  childRewards ChildReward[]

  @@index([schoolId])
  @@map("rewards")
}

enum RewardType {
  AVATAR
  BADGE
  ITEM
}

model ChildReward {
  id       String   @id @default(cuid())
  childId  String   @map("child_id")
  rewardId String   @map("reward_id")
  earnedAt DateTime @default(now()) @map("earned_at")

  child  Child  @relation(fields: [childId], references: [id])
  reward Reward @relation(fields: [rewardId], references: [id])

  @@index([childId])
  @@map("child_rewards")
}
